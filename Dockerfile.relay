# syntax=docker/dockerfile:1
FROM rust:1.98 AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

ADD --checksum=sha256:1b5f6f07e2c9b0c4bc82e2864be09f4aea4320165d5316e668616dbc822f428a \
    https://static.crates.io/crates/iroh-relay/iroh-relay-1.1.0.crate /tmp/iroh-relay.crate
RUN mkdir /build && tar -xzf /tmp/iroh-relay.crate -C /build
COPY security/iroh-relay.Cargo.lock /build/iroh-relay-1.1.0/Cargo.lock
RUN cargo install --path /build/iroh-relay-1.1.0 --features server --locked

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/cargo/bin/iroh-relay /usr/local/bin/iroh-relay
ENTRYPOINT ["iroh-relay"]
