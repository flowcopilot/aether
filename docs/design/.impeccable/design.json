  "components": [
    {
      "name": "Human route row",
      "kind": "custom",
      "refersTo": "route-row",
      "description": "One introduction link contains a title and setup explanation.",
      "html": "<a class=\"ds-route\" href=\"/aether/onboarding/human/\"><span class=\"ds-route-title\">For humans: set up Aether step by step</span><span class=\"ds-route-body\">Install the node, connect to one person, and send your first task. Plan for about 15 minutes.</span></a>",
      "css": ".ds-route{display:grid;grid-template-columns:1fr 1.2fr;gap:.75rem 2rem;padding:1.75rem 0;border-block:1px solid var(--sl-color-hairline);color:var(--sl-color-text);text-decoration:none;font-family:var(--sl-font);}.ds-route-title{font-size:1.5rem;font-weight:650;line-height:1.25;letter-spacing:-.02em}.ds-route-body{font-size:1rem;line-height:1.75;color:var(--sl-color-gray-2)}.ds-route:hover .ds-route-title{color:var(--sl-color-accent-high);text-decoration:underline;text-underline-offset:.2em}.ds-route:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:4px;}@media(max-width:40rem){.ds-route{grid-template-columns:1fr;gap:.75rem}}"
    },
    {
      "name": "Sidebar links",
      "kind": "nav",
      "refersTo": "sidebar-link",
      "description": "Desktop ordinary and current-page states.",
      "html": "<nav class=\"ds-sidebar\" aria-label=\"Start here\"><a href=\"/aether/\" aria-current=\"page\">Introduction</a><a href=\"/aether/onboarding/human/\">For humans</a><a href=\"/aether/onboarding/agent/\">For agents</a></nav>",
      "css": ".ds-sidebar{font-family:var(--sl-font);}.ds-sidebar a{display:block;border-radius:.25rem;text-decoration:none;color:var(--sl-color-gray-2);padding:.3em .5rem;line-height:1.4;font-size:.875rem}.ds-sidebar a:hover,.ds-sidebar a:focus{color:var(--sl-color-white)}.ds-sidebar a[aria-current=page]{font-weight:600;color:var(--sl-color-text-invert);background:var(--sl-color-text-accent)}.ds-sidebar a:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:4px;}"
    },
    {
      "name": "Desktop search trigger",
      "kind": "button",
      "refersTo": "search-trigger",
      "description": "Visual snapshot of the existing Starlight trigger; Starlight owns its behavior.",
      "html": "<button class=\"ds-search\" type=\"button\" aria-label=\"Search\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z\"/></svg><span>Search</span><kbd>Ctrl K</kbd></button>",
      "css": ".ds-search{display:flex;align-items:center;gap:.5rem;height:2.5rem;width:100%;max-width:22rem;border:1px solid var(--sl-color-gray-5);border-radius:.5rem;padding-inline:.75rem .5rem;background:var(--sl-color-black);color:var(--sl-color-gray-2);font-size:.875rem;cursor:pointer;font-family:var(--sl-font);}.ds-search kbd{margin-inline-start:auto;border-radius:.25rem;font-size:.75rem;padding-inline:.375rem;background:var(--sl-color-gray-6);font-family:var(--sl-font);}.ds-search:hover{border-color:var(--sl-color-gray-2);color:var(--sl-color-white)}.ds-search:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:4px;}"
    },
    {
      "name": "Search input",
      "kind": "input",
      "description": "Pagefind text input inside Starlight search.",
      "html": "<input class=\"ds-input\" type=\"search\" aria-label=\"Search\" placeholder=\"Search\"/>",
      "css": ".ds-input{height:calc(64px * var(--pagefind-ui-scale,.8));padding:0 calc(70px * var(--pagefind-ui-scale,.8)) 0 calc(54px * var(--pagefind-ui-scale,.8));background:var(--sl-color-black);border:1px solid var(--sl-color-gray-5);border-radius:8px;font-size:calc(21px * var(--pagefind-ui-scale,.8));color:var(--sl-color-white);font-weight:400;font-family:var(--sl-font);}.ds-input:focus{border-color:var(--sl-color-accent)}.ds-input:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:4px;}"
    },
    {
      "name": "Inline code",
      "kind": "custom",
      "refersTo": "inline-code",
      "description": "Technical text inside prose or route explanations.",
      "html": "<code class=\"ds-code\">agent.md</code>",
      "css": ".ds-code{background:var(--sl-color-bg-inline-code);color:var(--sl-color-text);font-family:var(--sl-font-mono);font-size:.8125rem;margin-block:-.125rem;padding:.125rem .375rem}"
    }
  ],
  "narrative": {
    "northStar": "The Inviting Reference Library",
    "overview": "Aether documentation borrows Audioflow’s lavender and plum palette and self-hosted typography. Expressive headings, readable prose, fine separators, and familiar Starlight navigation make technical material inviting.\n\nThis system applies only to the Astro documentation in `docs/`. The root `DESIGN.md` continues to govern the node and hub. Plain language and clear human and agent entry routes remain product commitments.",
    "keyCharacteristics": [
      "Lavender and plum in paired light and dark themes.",
      "Expressive sans serif with a precise monospace companion.",
      "A stable reading column between navigation and local contents.",
      "Human and agent route rows divided by fine rules."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Reference Starlight’s semantic color properties instead of binding components to one theme’s hex values.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do apply this palette and type only to the Astro documentation.",
      "Do use semantic Starlight color properties so both themes remain legible.",
      "Do preserve search, sidebar navigation, local contents, and visible keyboard focus.",
      "Do preserve human and agent setup routes, including the raw agent Markdown entry.",
      "Do respect the existing reduced motion override."
    ],
    "donts": [
      "Don’t change the node or hub identity from this scoped record.",
      "Don’t turn the route rows into decorative cards or add competing custom navigation.",
      "Don’t replace self-hosted fonts with an external font stylesheet."
    ]
  }
}
