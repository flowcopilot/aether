FROM rust:1.98 AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .
RUN cargo build --release --locked -p aether

FROM rust:1.98

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/release/aether /usr/local/bin/aether
ENTRYPOINT ["aether"]
