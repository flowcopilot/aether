.DS_Store
target/
whitepaper/*.pdf
brief-tehnologic/*.pdf

# Claude Code: personal settings and a runtime lock, never shared.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Personal editor settings.
.vscode/

# A global `*.sql` ignore rule (meant for local dump/log files) otherwise
# silently excludes this crate's migration sources from every commit.
!crates/aether-store/migrations/**/*.sql

# Impeccable: per-developer state and working files
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/mocks/
.impeccable/questions/
